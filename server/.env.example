# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/spot_cex"

# JWT secrets (use long random strings in development)
ACCESS_TOKEN_SECRET="your-access-token-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Optional token expiry (defaults: 1D access, 10D refresh)
# ACCESS_TOKEN_EXPIRY="1D"
# REFRESH_TOKEN_EXPIRY="10D"

# Frontend origin for CORS (must match your client URL)
CORS_ORIGIN="http://localhost:5173"

# Optional: email verification (Resend)
# RESEND_API_KEY="re_..."
# APP_URL="http://localhost:3001"

# Optional: production cookie security
# NODE_ENV="development"
