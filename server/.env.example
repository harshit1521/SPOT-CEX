# PostgreSQL connection string
# Neon / cloud: use sslmode=verify-full (not sslmode=require) to avoid pg driver warnings
DATABASE_URL="postgresql://user:password@localhost:5432/spot_cex"

# JWT secrets (use long random strings in development)
ACCESS_TOKEN_SECRET="your-access-token-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Optional token expiry (defaults: 1D access, 10D refresh)
# ACCESS_TOKEN_EXPIRY="1D"
# REFRESH_TOKEN_EXPIRY="10D"

# Frontend origin for CORS (must match your client URL)
CORS_ORIGIN="http://localhost:5173"
PORT=3001

# Email verification (Resend). Link in the email opens the client.
RESEND_API_KEY="re_..."
APP_URL="http://localhost:5173"
# Set to true to skip Resend and auto-verify new users
SKIP_EMAIL_VERIFICATION=true

# Optional: matching-engine Redis helper
# REDIS_URL="redis://localhost:6379"

# Optional: production cookie security
# NODE_ENV="development"
