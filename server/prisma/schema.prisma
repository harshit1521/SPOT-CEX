generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  username      String    @unique
  password      String

  emailVerified Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  balances      Balance[]
  fills         Fill[]   @relation("userFills")
  orders        Order[]

  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Market {
  id         Int      @id @default(autoincrement())
  symbol     String   @unique
  name       String
  baseAsset  String
  quoteAsset String
  createdAt  DateTime @default(now())
  fills      Fill[]
  orders     Order[]
}

model Order {
  id        BigInt      @id @default(autoincrement())
  userId    Int
  marketId  Int
  side      Side
  orderType OrderType
  price     Decimal?    @db.Decimal(30, 10)
  quantity  Decimal     @db.Decimal(30, 10)
  filledQty Decimal     @default(0) @db.Decimal(30, 10)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  buyFills  Fill[]      @relation("buyFills")
  sellFills Fill[]      @relation("sellFills")
  market    Market      @relation(fields: [marketId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([marketId, status])
}

model Fill {
  id          BigInt   @id @default(autoincrement())
  marketId    Int
  price       Decimal  @db.Decimal(30, 10)
  quantity    Decimal  @db.Decimal(30, 10)
  buyOrderId  BigInt?
  sellOrderId BigInt?
  userId      Int?
  createdAt   DateTime @default(now())
  buyOrder    Order?   @relation("buyFills", fields: [buyOrderId], references: [id])
  market      Market   @relation(fields: [marketId], references: [id])
  sellOrder   Order?   @relation("sellFills", fields: [sellOrderId], references: [id])
  user        User?    @relation("userFills", fields: [userId], references: [id])

  @@index([marketId, createdAt])
}

model Balance {
  id        Int      @id @default(autoincrement())
  userId    Int
  currency  String
  available Decimal  @default(0) @db.Decimal(30, 10)
  locked    Decimal  @default(0) @db.Decimal(30, 10)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, currency])
  @@index([userId])
}

enum Side {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}
